{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Minimal renderer capabilities for the AIbb pet window",
  "windows": ["pet"],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "core:window:allow-outer-position",
    "allow-load-aibb-profile",
    "allow-toggle-chat-window",
    "allow-open-settings-window",
    "allow-pet-drag-begin",
    "allow-pet-drag-move",
    "allow-pet-drag-end",
    "allow-save-pet-position",
    "allow-open-archive-window"
  ]
}
